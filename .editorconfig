# ==============================================================================
# .editorconfig · 代码风格（编辑器与工具的共同基准）
#
# ⚠️ 为什么要加这个：本项目此前**没有任何**风格配置（无 .editorconfig /
#    无 linter / 无 formatter），一致性纯靠人手维护。已装的
#    `biome.json` 只管 JS/CSS，Python 侧（scripts/ 下30+ 个脚本）
#    没有任何工具管 —— 这份文件是那边唯一的约束。
#
# 现有代码的实际风格（照着它写，不是反过来改代码）：
#   JS  2 空格 / 单引号 / 分号 / 尾逗号（es5）/ ~100 列
#   Py  4 空格 / 单引号为主 / ~120 列
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,css,json,html}]
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 120

[*.{rs,toml}]
indent_size = 4

[*.md]
# Markdown 行尾两个空格是"换行"语义，不能被 trim 掉
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

# 这些不该被格式化工具碰
[dist/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

[frontend/pkg/**]
# wasm-bindgen 生成物，不归我们管
insert_final_newline = unset
trim_trailing_whitespace = unset