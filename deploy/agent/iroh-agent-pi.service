[Unit]
Description=iroh chatroom agent (agent-pi + pi-sdk brain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/iroh-agent/agent-pi

# ⚠️ **不要用 root 跑**：这个进程会把"房间里任何人发来的文件"写进磁盘。
#    给它一个专用系统账号，并让 systemd 把其余文件系统设成只读 ——
#    这样即使 agent 侧出了漏洞，影响面也只落在 /opt/iroh-agent 里。
User=iroh-agent
Group=iroh-agent
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
# 只有这里可写（身份、pi 配置、收到的文件都在这下面）
ReadWritePaths=/opt/iroh-agent

# ⚠️ npm/node 的 PATH 必须显式给（node 装在独立目录时系统 PATH 里没有）
Environment=PATH=/opt/node22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 低权限账号没有真实 home；node/pi 会读 HOME，显式指到可写目录
Environment=HOME=/opt/iroh-agent/home
# iroh 侧身份与配置目录（独立于其他 agent/roomd）
Environment=IROH_AGENT_HOME=/opt/iroh-agent/home
# pi 侧 provider 配置目录（models.json；独立于用户的 ~/.pi）
Environment=PI_CODING_AGENT_DIR=/opt/iroh-agent/pi-agent

# 房间/昵称/大脑/文件策略都在这一行里改；改完 daemon-reload + restart
# ⚠️ `--room` 必须与你实际用的房间**完全一致**：房间名就是命名空间，
#    进错房间 = 谁也看不见谁（实测踩过：部署到 lobby、人在 patrick）。
# ⚠️ 文件接收：**当前部署是关的**（`--files off`，2026-10-12 所有者要求：
#    暂不做"发文件给 agent"）。此前是 `--files accept`（+ 64 MiB / 512 MiB / 落盘目录），
#    房间里任何人发文件都会被自动接收落盘。要开回来：把 `--files off` 换回
#    `--files accept --files-max-mb 64 --files-max-total-mb 512 --files-dir /opt/iroh-agent/received`，
#    并先确认沙箱/权限/落盘分区（见 README「运维」）。
ExecStart=/opt/node22/bin/node src/cli.ts \
  --room patrick \
  --nick 服务器助手 \
  --brain pi-sdk \
  --pi-model hahacode/gpt-6.1-sol \
  --agent-bin /opt/iroh-agent/bin/agent \
  --tools weather,fetch_url \
  --files off

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
