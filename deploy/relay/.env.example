# 复制成 .env 后按你的服务器改
# 证书来源目录（你的机器用哪个就填哪个）：
#   1Panel   : /opt/1panel/www/sites/relay-1.example.com/ssl
#   acme.sh  : /root/.acme.sh/relay-1.example.com_ecc
#   certbot  : /etc/letsencrypt/live/relay-1.example.com
CERT_SRC_DIR=/opt/1panel/www/sites/relay-1.example.com/ssl

# 证书源文件名（1Panel 与 certbot 都是 fullchain.pem/privkey.pem；acme.sh 是 fullchain.cer/<域名>.key）
CERT_SRC_CRT=fullchain.pem
CERT_SRC_KEY=privkey.pem

IROH_RELAY_VERSION=v1.3.0
CONTAINER_NAME=iroh-relay

# 只有改用 Manual 模式（而非 Reloading）时才需要：证书变了重启容器
RESTART_ON_CHANGE=0
